# Local Compose identity.  Copying this file to .env is safe for the local PoC
# only; do not reuse these values outside loopback development.
COMPOSE_PROJECT_NAME=vex

MYSQL_ROOT_PASSWORD=vex-local-root
MYSQL_DATABASE=vex
MYSQL_USER=vex
MYSQL_PASSWORD=vex-local-mysql
MYSQL_PORT=3306

MINIO_ROOT_USER=vexminio
MINIO_ROOT_PASSWORD=vex-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=git-vex-objects
MINIO_REGION=us-east-1

VALKEY_PORT=6379

GIT_HTTP_PORT=8080
GIT_HTTPS_PORT=8443
GIT_ALLOW_HTTP=1
VEX_HTTP_BASIC_USER=vex
VEX_HTTP_BASIC_PASSWORD=vex-local-push
VEX_HTTP_REQUIRE_PUSH_AUTH=1
# The Vex gateway streams normal Content-Length smart-HTTP bodies directly to
# CGI and keeps this as a bounded admission limit, not a RAM allocation.
# Eight GiB admits a git/git-scale local mirror push; lower it for tighter
# deployments.
VEX_HTTP_MAX_REQUEST_BYTES=8589934592
# Normal smart-HTTP request and socket-idle limits. The git/git seed workflow
# temporarily uses a longer bound for its one large import, then restores these
# exact values.
VEX_HTTP_CGI_TIMEOUT_SECONDS=300
VEX_HTTP_IO_TIMEOUT_SECONDS=300

# Target Vex storage configuration. Compose starts the source-built Vex
# MySQL+S3 smart-HTTP gateway by default; it uses these exact selectors.
GIT_VEX_BACKEND=mysql+s3
GIT_VEX_META_BACKEND=mysql
GIT_VEX_BLOB_BACKEND=s3
# Optional normal crash-recovery grace in seconds; blank uses the source
# default of 900. Test-only fault hooks are intentionally not persisted here.
GIT_VEX_EPOCH_RECOVERY_SECONDS=
# Optional derived-pack rebuild debounce in seconds; blank uses the source
# default of 60. Receives only queue/coalesce this metadata work; an operator
# or scheduler invokes scripts/vex/rebuild-pack.sh when it is due.
GIT_VEX_PACK_REBUILD_DELAY_SECONDS=
# Test-only first-seed pack-WAL gate. Leave blank for normal per-object
# receive behavior; test harnesses recreate only git-http with this set to 1.
GIT_VEX_RECEIVE_PACK_WAL=
# Test-only crash seam for raw receive-pack WAL recovery integration tests.
GIT_VEX_TEST_KILL_AT=
# The standalone derived-pack worker uses multipart above 64 MiB. Its part
# transport is bounded to 1..33 streams; begin a throughput experiment at 8.
VEX_PACK_WORKER_MULTIPART_PART_BYTES=67108864
VEX_PACK_WORKER_MULTIPART_CONCURRENCY=8
# Resource limits for the source-built smart-HTTP gateway. The defaults leave
# enough room for a git/git-scale receive-pack index while keeping the values
# explicit and locally overridable.
VEX_GIT_HTTP_CPUS=8.0
VEX_GIT_HTTP_MEMORY=4G
GIT_VEX_REPO_GIT_GIT_UUID=00000000-0000-4000-8000-000000000001
GIT_VEX_ORIGIN=https://localhost:8443/git/git.git
GIT_VEX_SMOKE_ORIGIN=https://localhost:8443/smoke.git

# Optional overrides for a derived image. Leaving these blank selects the
# bundled Vex MySQL+S3 command and its thin-repository initializer.
# To deliberately exercise the non-Vex classic-bare fallback, invoke the
# image directly without VEX_GIT_HTTP_COMMAND; Compose itself defaults to the
# bundled Vex command so its normal health result is meaningful data-plane
# evidence.
VEX_GIT_HTTP_COMMAND=
VEX_REPO_INIT_COMMAND=
