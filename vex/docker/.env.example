# Local Compose identity.  Copying this file to .env is safe for the local PoC
# only; do not reuse these values outside loopback development.
COMPOSE_PROJECT_NAME=vex

MYSQL_ROOT_PASSWORD=vex-local-root
MYSQL_DATABASE=vex
MYSQL_USER=vex
MYSQL_PASSWORD=vex-local-mysql
MYSQL_PORT=3306

MINIO_ROOT_USER=vexminio
MINIO_ROOT_PASSWORD=vex-local-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=git-vex-objects
MINIO_REGION=us-east-1

VALKEY_PORT=6379

GIT_HTTP_PORT=8080
GIT_HTTPS_PORT=8443
GIT_ALLOW_HTTP=1
VEX_HTTP_BASIC_USER=vex
VEX_HTTP_BASIC_PASSWORD=vex-local-push
VEX_HTTP_REQUIRE_PUSH_AUTH=1
VEX_HTTP_MAX_REQUEST_BYTES=67108864

# Target Vex storage configuration. Compose starts the source-built Vex
# MySQL+S3 smart-HTTP gateway by default; it uses these exact selectors.
GIT_VEX_BACKEND=mysql+s3
GIT_VEX_META_BACKEND=mysql
GIT_VEX_BLOB_BACKEND=s3
GIT_VEX_REPO_GIT_GIT_UUID=00000000-0000-4000-8000-000000000001
GIT_VEX_ORIGIN=https://localhost:8443/git/git.git
GIT_VEX_SMOKE_ORIGIN=https://localhost:8443/smoke.git

# Optional overrides for a derived image. Leaving these blank selects the
# bundled Vex MySQL+S3 command and its thin-repository initializer.
# To deliberately exercise the non-Vex classic-bare fallback, invoke the
# image directly without VEX_GIT_HTTP_COMMAND; Compose itself defaults to the
# bundled Vex command so its normal health result is meaningful data-plane
# evidence.
VEX_GIT_HTTP_COMMAND=
VEX_REPO_INIT_COMMAND=
