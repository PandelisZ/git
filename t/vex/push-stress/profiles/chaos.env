# SIGKILL the client child periodically.  A target may have committed before
# the client dies; only a fresh stock-Git fetch/fsck decides whether it did.
GIT_VEX_PUSH_STRESS_ORDER=first-parent
GIT_VEX_PUSH_STRESS_BATCH_MODE=fixed
GIT_VEX_PUSH_STRESS_BATCH_SIZE=1
GIT_VEX_PUSH_STRESS_MAX_COMMITS=200
GIT_VEX_PUSH_STRESS_KILL_EVERY=15
GIT_VEX_PUSH_STRESS_KILL_DELAY_MS=50
GIT_VEX_PUSH_STRESS_MAX_RETRIES=1
GIT_VEX_PUSH_STRESS_VERIFY_EVERY=10
GIT_VEX_PUSH_STRESS_FAIL_FAST=0
