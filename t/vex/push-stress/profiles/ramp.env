# Small transactions first, then repeat at 32 commits per transaction.
GIT_VEX_PUSH_STRESS_ORDER=first-parent
GIT_VEX_PUSH_STRESS_BATCH_MODE=ramp
GIT_VEX_PUSH_STRESS_BATCH_SIZE=1
GIT_VEX_PUSH_STRESS_BATCH_MAX=32
GIT_VEX_PUSH_STRESS_MAX_COMMITS=500
GIT_VEX_PUSH_STRESS_VERIFY_EVERY=25
GIT_VEX_PUSH_STRESS_FAIL_FAST=1
